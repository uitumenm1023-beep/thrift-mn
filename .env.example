# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or the "Connect" button).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (sb_publishable_...). Older projects call it the
# "anon" key — NEXT_PUBLIC_SUPABASE_ANON_KEY works too. Safe for the browser because Row
# Level Security protects the data. NEVER put the service_role / secret key
# in this app or in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the site, used for canonical links, Open Graph, the sitemap
# and email confirmation redirects. e.g. https://thrift.mn
NEXT_PUBLIC_SITE_URL=http://localhost:3000
